# EditorConfig helps developers define and maintain consistent coding styles
# between different editors and IDEs (https://editorconfig.org)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{nf,config}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonl}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{R,r}]
indent_style = space
indent_size = 2

[*.csv]
trim_trailing_whitespace = true
