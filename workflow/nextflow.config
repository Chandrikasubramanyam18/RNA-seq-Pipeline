// =============================================================================
//  rna-seq-pipeline Nextflow DSL2 — configuration
// =============================================================================
//
//  This workflow wraps the tools/commands that were validated manually on the
//  tutorial-scale GSE52778 dataset during Steps 2-9 of the project
//  (FastQC, fastp, STAR, SAMtools, RSeQC, featureCounts, DESeq2, visualization,
//  pathway analysis, MultiQC).
//
//  IMPORTANT semantics (locked):
//    * `-stub` proves WORKFLOW TOPOLOGY only (process graph & channel wiring).
//      It does NOT execute STAR/featureCounts/DESeq2 on real data.
//    * A real run executes the exact validated commands, but at tutorial scale
//      the reference contains only 3 genes, so results are NOT publication/
//      full biological analysis.
// =============================================================================

params {
    // --- Inputs --------------------------------------------------------------
    samplesheet        = "${projectDir}/../metadata/samplesheet.csv"
    fasta              = "${projectDir}/../data/reference/mini_real/mini_genome.fa"
    gtf                = "${projectDir}/../data/reference/mini_real/mini_genes.gtf"
    rseqc_bed          = "${projectDir}/../data/reference/mini_real/refgene.bed12"

    // --- Output --------------------------------------------------------------
    outdir             = "${projectDir}/../results_nextflow"
    multiqc_title      = "RNA-seq pipeline (tutorial-scale mini-reference)"

    // --- fastp ---------------------------------------------------------------
    fastp_qual         = 20
    fastp_min_len      = 30

    // --- STAR ---------------------------------------------------------------
    star_sjdb_overhang  = 62          // read_length - 1 (63 - 1)
    star_sa_index_nbases = 7          // mini_real genome: log2(99,836)/2-1 ~ 7.3
    star_multimap_nmax  = 20
    star_mismatch_nmax  = 10

    // --- Conda runtime -------------------------------------------------------
    // Left empty by default so `-stub` validation never triggers env setup.
    // For a real run point this at the repo env file, e.g.
    //   -profile conda
    // (or pass `params.conda_env_env`). See profiles below.
}

process {
    // Local executor: adequate for tutorial-scale (6 samples, 3-gene mini ref).
    executor = 'local'

    // Fine-grained resource labels used by modules.
    withName: 'FASTQC|FASTP|SAMTOOLS|RSEQC' {
        cpus   = 4
        memory = '8 GB'
        time   = '4 h'
    }
    withName: 'STAR_INDEX|STAR_ALIGN' {
        cpus   = 4
        memory = '12 GB'
        time   = '12 h'
    }
    withName: 'FEATURECOUNTS|DESEQ2|VISUALIZATION|PATHWAY|MULTIQC' {
        cpus   = 4
        memory = '8 GB'
        time   = '4 h'
    }

    // Never drop a finished task because of a tiny non-zero exit in testing.
    errorStrategy = 'retry'
    maxRetries    = 2
}

manifest {
    name        = 'rna-seq-pipeline'
    author      = 'Chandrika Subramanyam'
    description = 'Tutorial-scale RNA-seq pipeline (GSE52778, 3-gene mini-reference): FastQC -> fastp -> FastQC -> STAR -> SAMtools/RSeQC -> featureCounts -> DESeq2 -> visualization -> pathway -> MultiQC'
    version     = '0.1.0-tutorial'
    nextflowVersion = '>=23.10.0'
}

profiles {
    standard {
        process.conda = ''   // stub/topology validation must not create envs
    }
    conda {
        process.conda = "${projectDir}/../envs/rnaseq.yml"
    }
}